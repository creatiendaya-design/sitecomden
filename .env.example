# Plantilla de variables de entorno — copiar a `.env` y rellenar con valores reales.
# Este archivo SÍ se sube a git; `.env` está en .gitignore.
# Next.js NO lee este archivo en runtime, solo `.env` / `.env.local`.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Culqi — Pagos con tarjeta
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_REPLACE_ME
CULQI_SECRET_KEY=sk_test_REPLACE_ME
CULQI_WEBHOOK_SECRET=

# Vercel Blob — Almacenamiento de archivos (imágenes)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REPLACE_ME"

# Cloudflare Stream — Hosting de VIDEO (transcodificación + streaming adaptativo).
# OPCIONAL: si están vacíos, los videos suben a Vercel Blob como fallback.
# Cuando completes estas 2 variables, la librería de archivos enruta los
# videos a Cloudflare automáticamente (subida directa desde el navegador).
#   - CLOUDFLARE_ACCOUNT_ID: dashboard de Cloudflare (esquina de la URL / Stream).
#   - CLOUDFLARE_STREAM_API_TOKEN: token con permiso "Stream: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# OPCIONAL: tu subdominio de reproducción (ej: customer-abc123.cloudflarestream.com).
# Si lo dejas vacío se usa el dominio público videodelivery.net.
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# Resend — Envío de emails transaccionales
RESEND_API_KEY="re_REPLACE_ME"
# Remitente de los correos. Debe pertenecer a un dominio verificado en Resend.
# Si se deja vacío se usa el remitente por defecto del código, que en una
# tienda nueva es el de OTRA tienda.
RESEND_FROM_EMAIL=

# URL pública de la app — FUENTE ÚNICA de la URL canónica.
# La consumen sitemap, robots.txt, correos, redirects de pago y los eventos de
# tracking, todo vía `lib/site-url.ts`. En una tienda nueva es OBLIGATORIA:
# si falta, la resolución cae a `Setting.site_url` y, si tampoco existe,
# lanza error en producción (deliberado — emitir el dominio de otra tienda es
# peor que fallar visiblemente).
# NOTA: `NEXT_PUBLIC_URL` está deprecada. No la uses; ya no se lee.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credenciales del Super Admin creado por `npx tsx prisma/seed-permissions.ts`.
# OBLIGATORIO para crear el admin (contraseña mín. 8 caracteres). Sin
# SEED_ADMIN_PASSWORD el seed omite la creación (ya no hay contraseña por defecto).
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=

# Clerk v6+ — Autenticación de clientes
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Firma del webhook (Clerk dashboard → Webhooks → Signing Secret).
# OBLIGATORIA: sin ella `/api/webhooks/clerk` rechaza cada evento y NO se crea
# ni un solo `Customer`. La tienda parece funcionar hasta que miras la tabla.
CLERK_WEBHOOK_SECRET=
# Rutas de auth (opcionales — el código ya trae los valores por defecto).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Upstash Redis — Rate limiting
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_ME"

# SUNAT Electronic Invoicing — clave de cifrado AES-256 (32 bytes en hex = 64 chars)
# Generar con: openssl rand -hex 32
SUNAT_ENCRYPTION_KEY=

# Sentry — Error tracking (opcional pero MUY recomendado para producción)
# Si NEXT_PUBLIC_SENTRY_DSN está vacío, el SDK se inicializa como no-op.
# Crear proyecto en https://sentry.io/ y copiar el DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Para subir source maps en producción (opcional). Sin estos 3 vars,
# next.config.ts ignora el wrapper de Sentry y los stack traces quedan minificados.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cron de Vercel — protege los endpoints programados (warmup de Neon,
# liberación de reservas de stock). Sin este valor los endpoints quedan
# accesibles a cualquiera. Generar con: openssl rand -hex 32
CRON_SECRET=

# Minutos que se mantiene reservado el stock de una orden sin pagar.
# Vacío = valor por defecto de lib/inventory/reservation-policy.ts
ORDER_RESERVATION_MINUTES=

# Nivel de log de pino (trace|debug|info|warn|error|fatal).
# Vacío = "debug" en desarrollo, "info" en producción.
LOG_LEVEL=
